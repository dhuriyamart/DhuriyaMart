# ==============================================================================
# DhuriyaMart - Multi-Vendor E-Commerce Platform
# Production & Local Environment Configuration Template
# ==============================================================================

APP_NAME="DhuriyaMart"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Maintenance Driver
APP_MAINTENANCE_DRIVER=file

# Security & Password Hashing
BCRYPT_ROUNDS=12

# Application Logging
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# Database Configuration (MySQL InnoDB Required for Production)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dhuriyamart_production
DB_USERNAME=dhuriyamart_user
DB_PASSWORD=your_secure_mysql_password_here

# For local development with SQLite, uncomment the lines below:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ==============================================================================
# Session & Cache Drivers
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=dhuriyamart_cache_

# ==============================================================================
# Queue & Asynchronous Processing
# ==============================================================================
QUEUE_CONNECTION=database

# ==============================================================================
# Filesystem Storage
# ==============================================================================
FILESYSTEM_DISK=public

# ==============================================================================
# Mail Settings (SMTP / SES / Resend)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@dhuriyamart.com"
MAIL_FROM_NAME="DhuriyaMart Support"

# ==============================================================================
# Payment Gateway Configuration (Razorpay India)
# ==============================================================================
# Obtain sandbox or live credentials from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_DhuriyaMartSandbox
RAZORPAY_KEY_SECRET=rzp_test_DhuriyaMartSecretKey
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Enable sandbox simulator (set to 0 for production live transactions)
PAYMENT_SANDBOX_MODE=1

# Accept Cash on Delivery (1 = Yes, 0 = No)
COD_ENABLED=1

# ==============================================================================
# Marketplace Commercial & Shipping Settings
# ==============================================================================
DEFAULT_COMMISSION_RATE=10.00
FREE_SHIPPING_THRESHOLD_PAISE=49900
STANDARD_SHIPPING_FEE_PAISE=4900
TAX_RATE_PERCENT=5.00

# ==============================================================================
# Frontend Asset Compiler
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
